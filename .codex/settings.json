{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "_source": "metacodex",
            "_id": "journal-commit-check",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/journal-commit-check.mjs"
          },
          {
            "_source": "metacodex",
            "_id": "dirty-manifest-check",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/dirty-manifest-check.mjs"
          },
          {
            "_source": "metacodex",
            "_id": "trace-commit-staleness",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/trace-commit-staleness.mjs"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "_source": "metacodex",
            "_id": "superseded-artifact-warn",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/specs/**/*.md' 'node .codex/scripts/superseded-artifact-warn.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "trace-read-tracker",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/trace-read-tracker.mjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "_source": "metacodex",
            "_id": "json-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '*.json' 'node -e \"const f = process.argv[1]; if (!f.includes('\\''tsconfig'\\'')) JSON.parse(require('\\''fs'\\'').readFileSync(f))\" {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "codex-md-drift",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '*AGENTS.md' 'node .codex/scripts/verify-codex-md-base.mjs \"$(dirname {{file}})\" 2>&1 | head -10'"
          },
          {
            "_source": "metacodex",
            "_id": "manifest-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '*manifest.json' 'node .codex/scripts/validate-manifest.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "convergence-field-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '*manifest.json' 'node .codex/scripts/validate-convergence-fields.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "spec-manifest-sync",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/specs/groups/**/manifest.json' 'node .codex/scripts/validate-spec-manifest-sync.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "template-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/templates/*' 'node .codex/scripts/template-validate.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "agent-frontmatter-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/agents/*.md' 'node .codex/scripts/validate-agent-frontmatter.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "skill-frontmatter-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '*SKILL.md' 'node .codex/scripts/validate-skill-frontmatter.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "typescript-typecheck",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '*.ts,*.tsx' 'node .codex/scripts/workspace-tsc.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "eslint-check",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '*.ts,*.tsx,*.js,*.jsx' 'node .codex/scripts/workspace-eslint.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "structured-error-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '*.ts,*.tsx' 'node .codex/scripts/structured-error-validator.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "spec-schema-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/specs/**/*.md' 'node .codex/scripts/spec-schema-validate.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "spec-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/specs/**/*.md' 'node .codex/scripts/spec-validate.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "evidence-table-check",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/specs/**/*.md' 'node .codex/scripts/evidence-table-check.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "spec-approval-hash",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/specs/**/*.md' 'node .codex/scripts/spec-approval-hash.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "registry-artifact-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/registry/artifacts.json' 'node .codex/scripts/registry-artifact-validate.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "progress-heartbeat-check",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/specs/**' 'node .codex/scripts/progress-heartbeat-check.mjs {{file}}'"
          },
          {
            "_source": "metacodex",
            "_id": "session-state-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/session-validate.mjs"
          },
          {
            "_source": "metacodex",
            "_id": "structured-docs-validate",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '.codex/docs/**/*.yaml' 'node .codex/scripts/docs-validate.mjs --hook'"
          },
          {
            "_source": "metacodex",
            "_id": "prettier-format",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/hook-wrapper.mjs '*.{ts,tsx,js,jsx,json,md,css,scss,yml,yaml}' 'npx prettier --write {{file}} 2>/dev/null || true'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "_source": "metacodex",
            "_id": "convergence-gate-reminder",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/convergence-gate-reminder.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "_source": "metacodex",
            "_id": "workflow-stop-enforcement",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/workflow-stop-enforcement.mjs"
          },
          {
            "_source": "metacodex",
            "_id": "session-log",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && echo \"Session ended at $(date)\" >> .codex/context/session.log 2>/dev/null || true"
          },
          {
            "_source": "metacodex",
            "_id": "session-state-finalize",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node -e \"const fs=require('fs');const p='.codex/context/session.json';if(fs.existsSync(p)){const s=JSON.parse(fs.readFileSync(p));if(s.active_work){s.phase_checkpoint.checkpoint_state='interrupted';s.updated_at=new Date().toISOString();fs.writeFileSync(p,JSON.stringify(s,null,2))}}\" 2>/dev/null || true"
          },
          {
            "_source": "metacodex",
            "_id": "journal-promotion-check",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/journal-promotion-check.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "_source": "metacodex",
            "_id": "trace-read-enforcement",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/trace-read-enforcement.mjs"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "_source": "metacodex",
            "_id": "workflow-gate-enforcement",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/workflow-gate-enforcement.mjs"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "_source": "metacodex",
            "_id": "workflow-file-protection",
            "type": "command",
            "command": "cd \"$CODEX_PROJECT_DIR\" && node .codex/scripts/workflow-file-protection.mjs"
          }
        ]
      }
    ]
  }
}
